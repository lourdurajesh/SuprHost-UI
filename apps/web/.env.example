# Copy to .env.local for development. Never commit real values.

# Host → site key. Unknown hosts get a 404. Dev default: localhost=demo
SITE_DOMAINS=localhost=demo,127.0.0.1=demo

# HostMate public API (server-to-server, signed). Leave unset in dev to use the built-in mock.
PMS_API_URL=
PMS_API_KEY_ID=
PMS_API_SECRET=

# Production build with mock data (demos only). Never set in real production.
# SUPRHOST_USE_MOCK=1

# Cloudflare Turnstile. In production a missing secret rejects every booking request (fail closed).
# Cloudflare's public test keys for local runs: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public image CDN origin for listing photos, e.g. https://img.kaveristays.com
IMAGE_CDN_ORIGIN=

# Maps (search page and listing location). Free MapTiler key; without one, local dev falls back
# to OpenStreetMap tiles, which must not be used for production traffic.
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAPTILER_STYLE=streets-v2

# Mock only: where "Open PMS" points for the host account (the real value comes from the PMS).
PMS_APP_URL=http://localhost:5173
